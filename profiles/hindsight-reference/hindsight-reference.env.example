# Hindsight pinned 14e7306e27cdbd03ad5f17cf46f22a5f6d6ec5a2 (installed package 1.1.0).
# Opt-in reference/document profile, not a full extraction/reflect profile.
# Supply a NEW PostgreSQL/pgvector database URL through your local secret manager.
# Existing bank vectors MUST NOT be reused with a different embedding configuration.
# Model/tokenizer paths below are placeholders: provide pre-cached compatible E5 assets.
# This file does not install/download models or configure host-global hooks/authentication.
# Bind the API to 127.0.0.1 for local use; network/multiuser exposure needs separate auth review.
HINDSIGHT_API_LLM_PROVIDER=none
HINDSIGHT_API_RETAIN_LLM_PROVIDER=none
HINDSIGHT_API_REFLECT_LLM_PROVIDER=none
HINDSIGHT_API_CONSOLIDATION_LLM_PROVIDER=none
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_PROVIDER=none
HINDSIGHT_API_DECISION_MODEL_PROVIDER=none
HINDSIGHT_API_RETAIN_EXTRACTION_MODE=chunks
HINDSIGHT_API_ENABLE_OBSERVATIONS=false
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_MODEL_ID=intfloat/multilingual-e5-small
HINDSIGHT_API_EMBEDDINGS_ONNX_MODEL_PATH=/absolute/path/to/e5-small/model.onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_TOKENIZER_NAME_OR_PATH=/absolute/path/to/e5-small
HINDSIGHT_API_EMBEDDINGS_ONNX_DIMENSIONS=384
HINDSIGHT_API_EMBEDDINGS_ONNX_MAX_TOKENS=512
HINDSIGHT_API_EMBEDDINGS_ONNX_POOLING=mean
HINDSIGHT_API_EMBEDDINGS_ONNX_NORMALIZE=true
HINDSIGHT_API_EMBEDDINGS_ONNX_QUERY_PREFIX="query: "
HINDSIGHT_API_EMBEDDINGS_ONNX_PASSAGE_PREFIX="passage: "
HINDSIGHT_API_EMBEDDINGS_ONNX_BATCH_SIZE=16
HINDSIGHT_API_EMBEDDINGS_ONNX_CPU_MEM_ARENA=false
HINDSIGHT_API_EMBEDDINGS_ONNX_DEVICE=cpu
HINDSIGHT_API_RERANKER_PROVIDER=rrf
HINDSIGHT_API_WORKER_ENABLED=true
HINDSIGHT_API_WORKER_MAX_SLOTS=1
HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS=0
HINDSIGHT_API_WORKER_MAX_RETRIES=0
HINDSIGHT_API_MCP_ENABLED_TOOLS=retain,sync_retain,recall,get_document,delete_document,get_memory,list_memories,list_documents,get_operation,list_operations
HINDSIGHT_API_OTEL_TRACES_ENABLED=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
